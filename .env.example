# Primary: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fallback: https://console.groq.com/keys
GROQ_API_KEY=

# Path to a kubeconfig authenticating as the rca-agent ServiceAccount.
# Generate with: kubectl create token rca-agent -n otel-demo --duration=24h
# (see docs/security.md for the full kubeconfig-generation steps)
KUBECONFIG=
K8S_NAMESPACE=otel-demo
ALLOWED_NAMESPACES=otel-demo

PROMETHEUS_URL=http://localhost:30090
GRAFANA_URL=http://localhost:30080
JAEGER_URL=http://localhost:30686
LOKI_URL=http://localhost:30100

MAX_ITERATIONS=8
TOOL_CALL_BUDGET=30
MAX_TOOL_CALLS_PER_TURN=5
